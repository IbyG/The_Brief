{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/story-frame.schema.json",
    "title": "Story Frame",
    "type": "object",
    "additionalProperties": true,
    "required": ["headline", "sections"],
    "properties": {
      "rank": {
        "description": "Optional display order (lower numbers appear first). Omit or leave empty if not needed.",
        "oneOf": [
          { "type": "integer", "minimum": 1 },
          { "type": "null" },
          { "type": "string", "maxLength": 0 }
        ]
      },
      "headline": {
        "type": "string",
        "minLength": 1
      },
      "date_confirmed": {
        "type": "string",
        "description": "Display date in any author-preferred format (e.g. 05-04-2026, 2026-04-05, April 5 2026)"
      },
      "sources_confirmed": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "summary": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/section"
        }
      },
      "meta": {
        "$ref": "#/$defs/meta"
      }
    },
    "$defs": {
      "meta": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "topic": { "type": "string" },
          "audience": { "type": "string" },
          "priority": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "displayStyle": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "color": {
            "type": "string",
            "description": "Semantic name (primary, secondary, success, warning, error, neutral) or hex (#RRGGBB)"
          },
          "accent": { "type": "string" },
          "variant": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      },
      "contextField": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "array",
            "items": { "type": "string" }
          }
        ]
      },
      "section": {
        "oneOf": [
          { "$ref": "#/$defs/bulletListSection" },
          { "$ref": "#/$defs/cardsSection" },
          { "$ref": "#/$defs/linksSection" },
          { "$ref": "#/$defs/timelineSection" },
          { "$ref": "#/$defs/quoteSection" },
          { "$ref": "#/$defs/statsSection" },
          { "$ref": "#/$defs/genericSection" }
        ]
      },
      "baseSection": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "title", "items"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "layout": { "type": "string" },
          "columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "items": {
            "type": "array"
          }
        }
      },
      "bulletListSection": {
        "allOf": [
          { "$ref": "#/$defs/baseSection" },
          {
            "properties": {
              "type": { "const": "bullet_list" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/bulletItem" }
              }
            }
          }
        ]
      },
      "cardsSection": {
        "allOf": [
          { "$ref": "#/$defs/baseSection" },
          {
            "properties": {
              "type": { "const": "cards" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/cardItem" }
              }
            }
          }
        ]
      },
      "linksSection": {
        "allOf": [
          { "$ref": "#/$defs/baseSection" },
          {
            "properties": {
              "type": { "const": "links" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/linkItem" }
              }
            }
          }
        ]
      },
      "timelineSection": {
        "allOf": [
          { "$ref": "#/$defs/baseSection" },
          {
            "properties": {
              "type": { "const": "timeline" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/timelineItem" }
              }
            }
          }
        ]
      },
      "quoteSection": {
        "allOf": [
          { "$ref": "#/$defs/baseSection" },
          {
            "properties": {
              "type": { "const": "quotes" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/quoteItem" }
              }
            }
          }
        ]
      },
      "statsSection": {
        "allOf": [
          { "$ref": "#/$defs/baseSection" },
          {
            "properties": {
              "type": { "const": "stats" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/statItem" }
              }
            }
          }
        ]
      },
      "genericSection": {
        "allOf": [
          { "$ref": "#/$defs/baseSection" },
          {
            "properties": {
              "type": { "const": "generic" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/contentBlock" }
              }
            }
          }
        ]
      },
      "bulletItem": {
        "type": "object",
        "additionalProperties": true,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "color": { "type": "string" },
          "accent": { "type": "string" },
          "variant": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      },
      "cardItem": {
        "type": "object",
        "additionalProperties": true,
        "required": ["title", "description"],
        "properties": {
          "category": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "cta_label": { "type": "string" },
          "cta_url": { "type": "string", "format": "uri" },
          "context": { "$ref": "#/$defs/contextField" },
          "contexts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "color": { "type": "string" },
          "accent": { "type": "string" },
          "variant": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      },
      "linkItem": {
        "type": "object",
        "additionalProperties": true,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "source": { "type": "string" },
          "color": { "type": "string" }
        }
      },
      "timelineItem": {
        "type": "object",
        "additionalProperties": true,
        "required": ["text"],
        "properties": {
          "date": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "color": { "type": "string" }
        }
      },
      "quoteItem": {
        "type": "object",
        "additionalProperties": true,
        "required": ["quote"],
        "properties": {
          "quote": { "type": "string", "minLength": 1 },
          "speaker": { "type": "string" },
          "role": { "type": "string" },
          "color": { "type": "string" }
        }
      },
      "statItem": {
        "type": "object",
        "additionalProperties": true,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "value": {
            "type": ["string", "number", "boolean"]
          },
          "context": { "$ref": "#/$defs/contextField" },
          "contexts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "color": { "type": "string" },
          "accent": { "type": "string" },
          "variant": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      },
      "contentBlock": {
        "oneOf": [
          { "$ref": "#/$defs/bulletBlock" },
          { "$ref": "#/$defs/textBlock" },
          { "$ref": "#/$defs/linkBlock" },
          { "$ref": "#/$defs/statBlock" },
          { "$ref": "#/$defs/quoteBlock" }
        ]
      },
      "bulletBlock": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "const": "bullet" },
          "text": { "type": "string", "minLength": 1 },
          "color": { "type": "string" }
        }
      },
      "textBlock": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "const": "text" },
          "text": { "type": "string", "minLength": 1 },
          "color": { "type": "string" }
        }
      },
      "linkBlock": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "label", "url"],
        "properties": {
          "kind": { "const": "link" },
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "color": { "type": "string" }
        }
      },
      "statBlock": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "label", "value"],
        "properties": {
          "kind": { "const": "stat" },
          "label": { "type": "string", "minLength": 1 },
          "value": {
            "type": ["string", "number", "boolean"]
          },
          "context": { "$ref": "#/$defs/contextField" },
          "contexts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "color": { "type": "string" },
          "accent": { "type": "string" },
          "variant": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      },
      "quoteBlock": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "quote"],
        "properties": {
          "kind": { "const": "quote" },
          "quote": { "type": "string", "minLength": 1 },
          "speaker": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    }
  }
